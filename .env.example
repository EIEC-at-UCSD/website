# ---- Board + events sheet (optional) --------------------------------------
# The site reads two tabs of a Google Sheet that is published to the web as CSV.
# Defaults point at the 2026-27 sheet. To switch sheets, set all three
# (the gid is the number after gid= in the sheet's URL when that tab is open),
# then run `npm run snapshot` to refresh the fallback file.
# GOOGLE_SHEET_PUBLISHED_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub
# GOOGLE_SHEET_BOARD_GID=0
# GOOGLE_SHEET_EVENTS_GID=123456789

NEXT_PUBLIC_CONTACT_EMAIL=eiec.at.ucsd@gmail.com
